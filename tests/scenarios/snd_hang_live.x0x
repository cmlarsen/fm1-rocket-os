# T7a round 2: entering LIVE with a key held on a sound page releases the note.
wait 300
# the CHORDS/FM6 card: hold a key, then long-press PLAY into LIVE
cursor 3 0
tap EDIT
expect view 12
key 2 down
wait 100
press PLAY
wait 700
release PLAY
wait 20
expect mode 1
key 2 up
wait 300
expect fm6held 0
dump snd_hang_live.json
