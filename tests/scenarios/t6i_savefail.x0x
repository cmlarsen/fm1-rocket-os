# TFIXS r1/B1: a failed song save shows the error and stays dirty. Autosave does not retry it, but
# the explicit SAVE tap does (docs: "SAVE retries; a new edit also re-enables saving"), and it then
# succeeds on a different extent.
wait 300
assignkey 0 5
tap SAVE
expect songsaves 1
expect songfailed 0
expect songdirty 0
# inject a program failure, then force a save
assignkey 0 9
songfail
tap SAVE
expect songfailed 1
expect songdirty 1
expect songsaves 1
# autosave / a wait never retries a failed save
wait 6000
expect songfailed 1
expect songsaves 1
# the explicit SAVE retries and commits on another extent
tap SAVE
expect songfailed 0
expect songdirty 0
expect songsaves 2
# a new edit re-enables saving; the SAVE commits it
assignkey 0 11
expect songfailed 0
tap SAVE
expect songsaves 3
expect songdirty 0
reboot
expect keyclip0 11
