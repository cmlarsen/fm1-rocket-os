# T3 review #4: a key held across a layer or focus change releases the note that key started.
# The note is tracked per key, so SEL and ALGORITHM do not retarget it.
wait 300
# TCLS: the boot song is the Starter template, so BASS and LEAD have clips.
# enter LIVE and switch to the PLAY layer
press PLAY
wait 700
release PLAY
wait 20
expect mode 1
tap SEL
expect layer 1
shot live_hold.png
events live_hold_events.txt
# hold a BASS note, switch the layer to PADS, release: the BASS note releases (no hang)
key 0 down
tap SEL
expect layer 0
key 0 up
# back to PLAY; hold a note, change the focused role with ALGORITHM, release: the original releases
tap SEL
expect layer 1
key 2 down
turn ALGO 1
key 2 up
wait 100
eventsstop
