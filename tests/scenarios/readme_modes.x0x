# TDOC: the README's "The two modes" section. STUDIO builds the song (it is the view after
# boot); a long press on PLAY switches to LIVE to perform it, and a long press again returns.
# Shots: the STUDIO song home, the PLAY-hold ring, and LIVE's PADS layer.
wait 300
# STUDIO: the song home is the default view after boot. The boot song is the Starter
# template, so the DRUMS / BASS / LEAD / CHORDS rows already hold clips.
expect view 10
cursor 2 0
wait 1400
shot readme_studio_home.png

# --- the long press on PLAY: the ring fills over ~600 ms, then LIVE opens on release ---
press PLAY
wait 300
shot readme_live_enter.png
wait 400
release PLAY
wait 1400
expect mode 1
expect view 9
expect layer 0
shot readme_live_pads.png

# a plain PLAY tap starts the transport; the clips play where they are
tap PLAY
wait-bar 1
expect playing 1
shot readme_live_playing.png

# --- the long press again leaves LIVE and returns to STUDIO (or where you came from) ---
press PLAY
wait 700
release PLAY
wait 1400
expect mode 0
expect view 10
shot readme_studio_back.png
dump readme_modes.json
