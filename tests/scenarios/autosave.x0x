# AUTOSAVE (default ON): unsaved changes are saved by themselves while stopped, once nothing has been
# touched for 4 s, writing only the objects that changed; never while playing; never when OFF.
# TCLS: the project is settings + sound now (the pattern bank is gone), and the song saves too.
wait 300
expect store_writes 0
# a sound change (the 909 BD Tune), stopped
tap EDIT
turn K1 5 80
wait 3000
expect store_writes 0
wait 1500
# the first save writes the settings and the sound (nothing was on the flash yet)
expect store_writes 2
# one more sound change: only the sound object changes, so one write
wait 21000
turn K1 1 80
wait 25000
expect store_writes 3
# playing: an edit is not saved, however long it waits
tap PLAY
turn K1 1 80
wait 25000
expect store_writes 3
tap PLAY
wait 25000
expect store_writes 4
# GLO > AUTOSAVE OFF (TCLS: row 12): saved once more (the setting itself), then edits wait for SAVE
tap HOME
tap GLO
turn SELECT 12
turn ALGO -1
tap HOME
wait 25000
expect store_writes 5
tap EDIT
turn K1 1 80
wait 25000
expect store_writes 5
