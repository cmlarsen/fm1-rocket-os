# T3 LIVE, the PLAY layer: SCL toggles layers, the keys play the focused role, and leaving LIVE
# hands the transport back to X0X's sequencer with no hung note.
wait 300
# TCLS: the boot song is the Starter template, so BASS and LEAD have clips.
# enter LIVE
press PLAY
wait 700
release PLAY
wait 50
expect mode 1
expect layer 0
# SCL toggles to the PLAY layer
tap SEL
expect layer 1
shot live_play.png
# the keys play the focused role (BASS, the default) chromatically: three notes
events live_play_events.txt
tapkey w0
tapkey w2
tapkey w4
# hold a note across the exit: leaving LIVE must release it (no hung note)
key 0 down
press PLAY
wait 700
release PLAY
key 0 up
eventsstop
expect mode 0
expect view 10
# back in STUDIO, the clip engine plays again
tap PLAY
expect playing 1
wait-bar 1
expect bar 1
dump live_play.json
tap PLAY
expect playing 0
