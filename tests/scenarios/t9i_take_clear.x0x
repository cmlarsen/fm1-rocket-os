# T9i: clear the take by holding REC for 1.5 s (the ring fills; the clips keep playing), then
# HOME + REC restores it. The clear is stored as an empty take on the next flush.
wait 300
tap GLO
tap SEL
tapkey w0
turn ALGO 2
tapkey w0
turn ALGO -3
songseed
press PLAY
wait 700
release PLAY
wait 50
tap REC
tap PLAY
wait-bar 1
tapkey 0
wait-bar 2
tap REC
wait-bar 2
expect takehas 1
echo recorded
tap PLAY
wait 400
expect takeplaying 0
echo recorded; flush it (leave LIVE; the save rides autosave, B3)
press PLAY
wait 700
release PLAY
wait 4500
expect songsaves 1
expect takepend 0
echo re-enter LIVE
press PLAY
wait 700
release PLAY
wait 50
echo clear next
press REC
wait 1700
release REC
wait 100
expect takehas 0
echo cleared
expect takepend 1
echo undo next
press HOME
tap REC
release HOME
wait 100
expect takehas 1
echo undone
dump t9i_take_clear.json
