# Cross-role clips, role stops, tap/hold FX and live notes through the real setup UI.
wait 300
songseed
press PLAY
wait 700
release PLAY
tap EDIT
tap SEL
expect assign 1
key 16 down
turn PRESET 4 80
expect keyclip16 16
wait 1000
shot tlset_live7_assign.png
key 16 up
expect keyclip16 20
# Assign key 0 to Stop CHORDS (30).
key 0 down
turn PRESET 30 80
key 0 up
expect keyclip0 30
# Assign key 1 to repeat 1/8 (32).
key 1 down
turn PRESET 31 80
key 1 up
expect keyclip1 32
# Assign key 2 to live note (38).
key 2 down
turn PRESET 36 80
key 2 up
expect keyclip2 38
tap HOME
turn SELECT 2 80
turn ALGO 1 80
expect stagelock 1
tap EDIT
expect setup 0
tap PLAY
press HOME
tapkey 16
release HOME
wait 80
expect liveclip3 20
press HOME
key 16 down
wait 1600
key 16 up
release HOME
expect clipused20 1
wait 1000
expect liveclip3 -1
press HOME
tapkey 16
release HOME
wait 80
expect liveclip3 20
tapkey 0
wait 2200
expect liveclip3 -1
tapkey 1
expect fxlatch0 1
tapkey 1
expect fxlatch0 0
key 1 down
wait 500
key 1 up
expect fxlatch0 0
key 1 down
wait 500
tap EDIT
key 1 up
expect fxlatch0 0
tap EDIT
turn ALGO 2 80
key 2 down
wait 80
expect heldnotes 1
tap EDIT
expect heldnotes 0
key 2 up
# Leaving an unfinished assignment cancels it.
tap SEL
key 3 down
turn PRESET 20 80
tap EDIT
key 3 up
expect keyclip3 3
stop
wait 3000
expect heldnotes 0
expect midiheld 0
expect fm6held 0
expect songwrites 0
