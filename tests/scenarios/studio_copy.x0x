# T7a STUDIO 14: hold a loaded pad; the empty keys blink slowly as targets; tap one to copy the
# source clip there (same role only), with an undo entry.
wait 300
tap SEQ
tap HOME
wait 1400
expect clipused0 1
# hold the source pad; the cursor sits on it and the empty DRUMS slots blink
key w0 down
wait 600
expect studioclip 0
shot studio_copy.png
tapkey b0
key w0 up
expect clipused1 1
expect undodepth 1
# the copy is undoable
press HOME
tap REC
release HOME
expect clipused1 0
wait 1400
shot studio_copy_undone.png
dump studio_copy.json
