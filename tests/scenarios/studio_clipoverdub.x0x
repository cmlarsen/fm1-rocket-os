# T7b: REC on a loaded clip overdubs. A 1-bar pass records two notes; a second pass, while the clip
# plays, follows the clip's own playhead and adds two more; the length is untouched.
wait 300
cursor 1 0
tap REC
key w7 down
key w7 up
wait 200
key w8 down
key w8 up
tap REC
wait-bar 2
expect clipnotes7 2
expect cliplen7 16
# overdub while it plays: REC again adds notes at the playhead steps
tap REC
expect recrec 1
wait-bar 1
key w9 down
key w9 up
wait 200
key w10 down
key w10 up
tap REC
wait-bar 2
expect recrec 0
expect clipnotes7 4
expect cliplen7 16
wait 1400
shot studio_clipoverdub.png
dump studio_clipoverdub.json
