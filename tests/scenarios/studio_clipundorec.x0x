# T7b: a record pass on an empty slot is one undo entry, and the creation is inside it: HOME + REC
# leaves the slot empty again and stops the role.
wait 300
newsong 0
cursor 1 0
tap REC
key w0 down
key w0 up
wait 200
key w2 down
key w2 up
wait 200
key w4 down
key w4 up
tap REC
wait-bar 2
expect clipnotes7 3
expect cliplen7 16
expect clipused7 1
expect undodepth 1
# HOME + REC undoes the pass (and the clip the slot created); the clip stops at its quantize
press HOME
tap REC
release HOME
expect clipnotes7 0
expect clipused7 0
wait-bar 1
expect liveclip1 -1
expect undopos 0
wait 1400
shot studio_clipundorec.png
dump studio_clipundorec.json
