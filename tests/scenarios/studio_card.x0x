# T7a follow-up D6: the card reads the real mode and shows sub-bar lengths in steps, and its left
# line names the song's key and scale.
wait 300
expect songkey 0
expect songscale 0
tap SEQ
spin K1 -4
expect cliplen0 12
spin K2 1
expect clipmode0 1
tap HOME
expect clipused0 1
wait 1400
shot studio_card_steps.png
dump studio_card.json
