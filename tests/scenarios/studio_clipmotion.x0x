# T7b STUDIO 15: motion. On the motion page while a pass records, a knob writes the value at the
# pass's playhead step (not the note cursor); the first two distinct params claim lane 0 and lane 1,
# a third stays off with "2 lanes max"; the lanes play back as the clip engine's motion events.
wait 300
newsong 0
cursor 1 0
tap REC
expect recrec 1
tap SEQ
expect view 14
wait-bar 1
spin K1 30
wait 250
spin K1 30
wait 250
spin K1 -20
wait 250
spin K2 40
wait 250
spin K2 20
# a third param: no lane, "2 lanes max"
spin K3 40
expect mlparam7.1 >0
tap REC
wait-bar 2
expect recrec 0
expect mlparam7.0 >0
expect mlparam7.1 >0
expect mlany7.0 1
expect mlval7.0.0 -1
wait 1400
shot studio_clipmotion.png
dump studio_clipmotion.json
events studio_clipmotion_events.txt
wait-bar 1
eventsstop
