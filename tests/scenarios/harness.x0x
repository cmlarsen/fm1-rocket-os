# T2a harness: the runner commands (dump, wait-bar, events/eventsstop) and the expect keys
# (bar, beat, key, button). The sample counter is the only clock, so every value here is
# deterministic.
wait 300
# TCLS: STUDIO opens on the song home (the boot song is the Starter template).
expect view 10
expect mode 0
expect clipused0 1
# the cursor clip's key is bright; an empty DRUMS slot's key is dark
expect key 0 2
expect key 4 0
expect button SAVE 0
# events: every engine command from here, with its sample time
events harness_events.txt
param 0 0 0 64
wait 100
eventsstop
# transport: PLAY starts the clip engine; its bar boundary is wait-bar
tap PLAY
expect playing 1
wait-bar 1
expect bar 1
expect beat <4
expect step <16
shot harness_playing.png
dump transport.json
tap PLAY
expect playing 0
