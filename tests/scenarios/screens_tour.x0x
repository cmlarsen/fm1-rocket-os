# T2b screen tour: visit every surviving view and overlay and take a shot of each.
# `make screens-lint` runs this with a host build that records every text draw (-DX0X_LINT)
# and checks the shots for clipped or overlapping text. `make screens` shows them at 1:1.
# TCLS: the X0X pattern pages (HOME/PART-step/GEN/SEQ/SONG) are gone; the tour covers the
# surviving sound/FX/MIX/GLOBAL pages, STUDIO and LIVE.
wait 300
# T11h: the two help systems, so screens-lint sees them too (the same STUDIO shots as
# tests/scenarios/help_cards.x0x). SYSTEM 1 is the HOME-hold cheat sheet; SYSTEM 2 is GLO + a
# button.
press HOME
wait 450
shot z00_sheet_studio.png
release HOME
wait 100
press GLO
wait 60
press REC
wait 60
shot z01_card_rec_studio.png
release REC
release GLO
wait 60
press GLO
wait 60
press SEQ
wait 60
shot z02_card_seq_studio.png
release SEQ
release GLO
wait 100
# T7a STUDIO 1: the song home; the empty slot
turn SELECT 4
wait 1400
shot s00_studio_home.png
turn SELECT -4
shot s00b_studio_empty.png
# T7b STUDIO 3: the notes editor (SEQ creates BASS A and opens NOTES)
cursor 1 0
tap SEQ
wait 1400
shot s00c_studio_notes.png
# T7b STUDIO 15: motion, then STUDIO 5: settings (SEQ cycles the editor's pages)
tap SEQ
wait 1400
shot s00d_studio_motion.png
tap SEQ
wait 1400
shot s00e_studio_clipset.png
tap HOME
wait 1400
# T7b STUDIO 4: the drum grid (DRUMS A)
cursor 0 0
tap SEQ
wait 1400
shot s00f_studio_drums.png
tap HOME
wait 1400
# T7a STUDIO 9: the clear ring
press HOME
key w0 down
wait 700
shot s00g_studio_clear.png
key w0 up
release HOME
# T7a: the sound cards (EDIT from the song home)
cursor 3 0
tap EDIT
wait 300
shot s00h_sound_fm6.png
tap HOME
cursor 1 0
tap EDIT
wait 300
shot s00i_sound_303.png
tap HOME
# a little content, so the screens are not empty
tap PLAY
wait 400
# FX
tap FX
wait 150
shot s04_fx.png
# MIX
tap LFO
wait 150
shot s05_mix.png
# GLOBAL (GLO opens its list)
tap GLO
wait 150
shot s08_global.png
# O_ASK: the list's FACTORY RESET asks first (TCLS: row 13)
turn SELECT 13
wait 80
tap SEL
wait 150
shot s09_ask.png
tap HOME
wait 300
# O_LIST: SELECT opens the page list
tap SEL
wait 150
shot s10_list.png
tap HOME
wait 300
# PERF (GLOBAL > PERFORMANCE; TCLS: row 14)
tap GLO
wait 150
turn SELECT 14
wait 80
tap SEL
wait 300
shot s11_perf.png
tap HOME
wait 300
# LIVE: PADS, PLAY and the punch FX layer
press PLAY
wait 700
release PLAY
wait 100
shot s13_live_pads.png
tap SEL
wait 150
shot s14_live_play.png
press FX
wait 100
shot s15_live_fx.png
release FX
wait 100
press PLAY
wait 700
release PLAY
wait 150

# TLSET: seven-row setup, assignment and the external-clock header at 1:1.
reboot
wait 300
press PLAY
wait 700
release PLAY
tap EDIT
wait 1600
shot tour_live_setup.png
tap SEL
key 16 down
turn PRESET 4 80
shot tour_live_assign.png
key 16 up
tap HOME
turn SELECT 5 80
turn ALGO -1 80
midiclock 100 25
wait 20
shot tour_live_ext.png
tap EDIT
