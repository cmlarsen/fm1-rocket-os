# SAVE while playing waits for the stop (writing the flash stops the audio), then saves
wait 300
# T7a: enter the classic X0X pages (GLOBAL -> Classic patterns).
tap GLO
tap SEL
tapkey w0
tap PLAY
wait 500
expect store_writes 0
tap SAVE
wait 500
expect store_writes 0
tap PLAY
wait 300
expect store_writes >0
