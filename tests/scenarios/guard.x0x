# The overload guard (engine.c): past the CPU it lightens the 303s and the 808's tails, shows GUARD,
# and lets go after 3 s back under 75% (T5perf raised the release from 65% so it does not stay on at
# 66-69%). "load N" stands in for the FM-1's measured load.
wait 300
# TCLS: the boot song is the Starter template, so PLAY drives the clip engine.
tap PLAY
wait 1500
expect guard 0
# a block over 92%: on at once, and the music plays on
load 95
wait 100
expect guard 1
expect guardcount 1
shot g01_guard.png
peakreset
wait 2000
expect peak_db_max >-30
# 2 s under 75% is not enough; 3 s is
load 40
wait 2000
expect guard 1
wait 1500
expect guard 0
# 80% sustained is under the 85% engage: no guard from off
load 80
wait 2000
expect guard 0
# 90% sustained crosses the average engage
load 90
wait 2000
expect guard 1
expect guardcount 2
# a load that comes back between 75 and 92 keeps it on
load 80
wait 5000
expect guard 1
# ... but a load under 75 releases it (T5perf: the release is 75, not 65)
load 70
wait 3500
expect guard 0
