# The overload guard (engine.c): past the CPU it lightens the 303s and the 808's tails, shows GUARD,
# and lets go after 3 s back under 75% (T5perf raised the release from 65% so it does not stay on at
# 66-69%). "load N" stands in for the FM-1's measured load.
wait 300
# T7a: enter the classic X0X pages (GLOBAL -> Classic patterns).
tap GLO
tap SEL
# 909 kick on the quarters, 808 too, 303 A on a TB-3PO line
tapkey b0
tapkey w0
tapkey w4
tapkey w8
tapkey w12
turn ALGO 1
tapkey w0
tapkey w8
turn ALGO 1
tap ARP
tap OCT+
tap PLAY
wait 1500
expect guard 0
# a block over 92%: on at once, and the music plays on
load 95
wait 100
expect guard 1
expect guardcount 1
shot g01_guard.png
peakreset
wait 2000
expect peak_db_max >-30
# 2 s under 75% is not enough; 3 s is
load 40
wait 2000
expect guard 1
wait 1500
expect guard 0
# 80% sustained is under the 85% engage: no guard from off
load 80
wait 2000
expect guard 0
# 90% sustained crosses the average engage
load 90
wait 2000
expect guard 1
expect guardcount 2
# a load that comes back between 75 and 92 keeps it on
load 80
wait 5000
expect guard 1
# ... but a load under 75 releases it (T5perf: the release is 75, not 65)
load 70
wait 3500
expect guard 0
# the PERF test measures the full cost: no guard while it runs, back after
load 95
tap PLAY
tap GLO
turn SELECT 16
tap SEL
expect view 7
tap SEL
turn SELECT 1
tap SEL
wait 1000
expect perftest 0
expect guard 0
shot g02_perftest.png
tap HOME
wait 300
expect perftest -1
wait 100
expect guard 1
shot g03_perf_after.png
