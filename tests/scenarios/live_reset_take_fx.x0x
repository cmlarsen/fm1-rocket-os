# TFIXU r1 #2: HOME + FX releases each latched punch FX through the recorded path, so a take
# played back ends with the effect off after the reset point. Before the fix engine_perform_reset
# recorded nothing, so the replay re-latched it (the final expect got 1).
wait 300
press PLAY
wait 700
release PLAY
wait 50
tap REC
tap PLAY
wait-bar 1
expect takerec 1
press FX
wait 30
tapkey w0                           # tap REPEAT 1/8: latch it
release FX
wait 40
expect fxlatch0 1
wait-bar 1
press HOME
press FX
wait 100
release FX
release HOME
wait 40
expect fxlatch0 0                   # live: the reset releases the latched effect
wait-bar 2
tap REC
wait-bar 2
expect takehas 1
takedump take.txt
tap PLAY
wait 400
takeplay
wait-bar 1
wait-bar 1
wait-bar 1
expect fxlatch0 0                   # the replay records the release, so it stays off
