# T7a round 2: in LIVE's PLAY layer, holding a key across the SEL layer toggle still releases the
# note the key started when it is let go.
wait 300
tap SEQ
tap HOME
tap SEL
tap PLAY
wait-bar 1
press PLAY
wait 700
release PLAY
wait 20
expect mode 1
tap SEL
expect layer 1
events snd_hang_sel_events.txt
key 2 down
wait 100
tap SEL
expect layer 0
key 2 up
wait 300
eventsstop
expect bassheld 0
dump snd_hang_sel.json
tap PLAY
