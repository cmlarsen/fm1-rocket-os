# T11i: a MIDI note held across a view change is released, and a note-off after it still lands;
# then a deterministic MIDI fuzz: no note is left held and no T5i voice sounds.
wait 300
# focus CHORDS (FM6), so the voice counters are meaningful: enter LIVE, ALGO +2, leave
press PLAY
wait 700
release PLAY
wait 20
turn ALGO 2 80
expect focus 3
press PLAY
wait 700
release PLAY
wait 50
expect mode 0
midi 90 3C 64
wait 50
expect fm6held 1
tap GLO                                         # a view change releases what MIDI held
wait 200
expect fm6held 0
expect midiheld 0
midi 80 3C 00                                   # the late note-off is harmless
wait 2000
expect fm6voices 0
# the fuzz: random notes / PC / CC across the 16 channels, then the panic on every channel
midifuzz 12345 300
wait 100
expect midiheld 0
expect fm6voices 0
expect nzvoices 0
dump midi_hold.json
